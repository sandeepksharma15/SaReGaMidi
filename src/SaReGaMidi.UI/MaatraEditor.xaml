<Window x:Class="SaReGaMidi.UI.MaatraEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit maatra" Width="660" Height="690"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WorkspaceWindow}">
    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorOutlineBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource EditorButton}" />
        <Style x:Key="EditorApplyButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="Preview" HorizontalContentAlignment="Center" />
                    </ScrollViewer>
                </DockPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Swaras in this maatra" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ListBox x:Name="EventsList" Style="{StaticResource PageListStyle}" VerticalAlignment="Top"
                             MinHeight="54" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Swaras in this maatra">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Glyph}" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="_Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button Content="_Apply" IsDefault="True" Click="Apply_Click" Style="{StaticResource EditorApplyButton}" MinWidth="84" />
            </StackPanel>
            <TextBlock x:Name="Message" Style="{StaticResource MutedText}" Margin="0,0,12,0"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <TabControl x:Name="EditorTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="_Swaras and lyrics" Style="{StaticResource WorkspaceTab}" Margin="0,0,6,8">
                <Border Style="{StaticResource Card}" Padding="0" BorderBrush="{DynamicResource EditorOutlineBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="_Remove swara" Click="Remove_Click" />
                                <Label DockPanel.Dock="Left" Content="_Saptak" Target="{Binding ElementName=SaptakBox}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="SaptakBox" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Saptak_Changed" />
                            </DockPanel>
                            <UniformGrid x:Name="Palette" Rows="1" Columns="12" Margin="0,14,0,10" />
                            <Button x:Name="CancelKanButton" Content="Cancel kan selection" Click="Kan_Click"
                                    Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
                                <Button Content="-  Sustain" Click="Sustain_Click" Margin="0,0,8,0" />
                                <Button Content="*  Silence" Click="Silence_Click" Margin="0,0,8,0" />
                                <Button Content="?  Unclear" Click="Unclear_Click" />
                            </UniformGrid>
                            <Label Content="_Lyrics" Target="{Binding ElementName=LyricsBox}" Padding="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="S  Continue vowel" Click="ContinueLyric_Click" Width="210" Margin="12,0,0,0" />
                                <TextBox x:Name="LyricsBox" TextChanged="Preview_Changed" FontFamily="Nirmala UI" FontSize="16" VerticalContentAlignment="Center" Padding="8,4" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="_Timing and ornaments" Style="{StaticResource WorkspaceTab}" Margin="0,0,6,8">
                <Border Style="{StaticResource Card}" Padding="0" BorderBrush="{DynamicResource EditorOutlineBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="Select a swara above to edit its duration or ornament."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,8">
                                <Label DockPanel.Dock="Left" Content="_Duration" Target="{Binding ElementName=DurationBox}"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBox x:Name="DurationBox" Width="96" Height="36" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,4"
                                         Text="{Binding SelectedItem.Duration, ElementName=EventsList, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="Leave durations blank for equal divisions. For unequal timing, use a fraction such as 1/3."
                                       Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <CheckBox x:Name="GroupBox" Content="Group swaras under one maatra"
                                      Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,4,0,18" />
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
                                <Button Content="खटका" FontFamily="Nirmala UI" Click="Khatka_Click" Margin="0,0,8,0" />
                                <Button Content="कण" FontFamily="Nirmala UI" Click="Kan_Click" Margin="0,0,8,0" />
                                <Button x:Name="MeendButton" Content="मींड" FontFamily="Nirmala UI" Click="Meend_Click" />
                            </UniformGrid>
                            <Border x:Name="MeendPanel" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}"
                                    BorderBrush="{DynamicResource EditorOutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Label DockPanel.Dock="Left" Content="_Maatras ahead" Target="{Binding ElementName=MeendDistanceBox}"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="MeendDistanceBox" DockPanel.Dock="Left" Width="52" Margin="0,0,10,0"
                                                 VerticalContentAlignment="Center" ToolTip="Leave blank for all later swaras"
                                                 TextChanged="MeendDistance_Changed" />
                                        <ComboBox x:Name="MeendDestinationBox" DisplayMemberPath="Label"
                                                  AutomationProperties.Name="Meend destination" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button Content="Next swara" Click="NextMeend_Click" Margin="0,0,8,0" />
                                        <Button Content="Set meend" Click="SetMeend_Click" Margin="0,0,8,0" />
                                        <Button Content="Clear meend" Click="ClearMeend_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="_Layout and source" Style="{StaticResource WorkspaceTab}" Margin="0,0,6,8">
                <Border Style="{StaticResource Card}" Padding="0" BorderBrush="{DynamicResource EditorOutlineBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="_Section" Target="{Binding ElementName=SectionBox}" Padding="0,0,0,4" />
                                    <TextBox x:Name="SectionBox" MinHeight="35" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Start _beat" Target="{Binding ElementName=StartBeatBox}" Padding="0,0,0,4" />
                                    <TextBox x:Name="StartBeatBox" MinHeight="35" VerticalContentAlignment="Center"
                                             ToolTip="Set on the first maatra of a section" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Content="Source _page" Target="{Binding ElementName=PageBox}" Padding="0,0,0,4" />
                                    <ComboBox x:Name="PageBox" MinHeight="35" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="PrintedLineBox" Content="Start a new printed line" Margin="0,0,0,8" />
                            <CheckBox x:Name="BlankBox" Content="Leave swara row blank (keep the beat)"
                                      Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,0,6" />
                            <CheckBox x:Name="WholeBlankBox" Content="Leave the whole maatra blank (swaras and lyrics)"
                                      Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,0,6" />
                            <CheckBox x:Name="BorrowBox" Content="Use the earlier swaras on this beat during the pass" Margin="16,0,0,10" />
                            <Label Content="_Notes / cues" Target="{Binding ElementName=NotesBox}" Padding="0,0,0,4" />
                            <TextBox x:Name="NotesBox" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" Padding="8,6" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
