<Window x:Class="SaReGaMidi.UI.MaatraEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit maatra" Width="570" SizeToContent="Height" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WorkspaceWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <WrapPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,10,0">
                    <Label Content="_Section" Target="{Binding ElementName=SectionBox}" Padding="0,0,0,4" />
                    <TextBox x:Name="SectionBox" Width="180" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <Label Content="Start _beat" Target="{Binding ElementName=StartBeatBox}" Padding="0,0,0,4" />
                    <TextBox x:Name="StartBeatBox" Width="90" ToolTip="Set on the first maatra of a section" />
                </StackPanel>
                <StackPanel>
                    <Label Content="Source _page" Target="{Binding ElementName=PageBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="PageBox" Width="95" />
                </StackPanel>
            </WrapPanel>
            <Label Content="_Saptak" Target="{Binding ElementName=SaptakBox}" Padding="0,0,0,4" />
            <ComboBox x:Name="SaptakBox" Width="180" HorizontalAlignment="Left" SelectionChanged="Saptak_Changed" />
            <UniformGrid x:Name="Palette" Rows="1" Columns="12" Margin="0,10,0,4" />
            <WrapPanel Margin="0,0,0,8">
                <Button Content="–  Sustain" Click="Sustain_Click" Margin="0,0,6,0" />
                <Button Content="*  Silence" Click="Silence_Click" Margin="0,0,6,0" />
                <Button Content="?  Unclear" Click="Unclear_Click" Margin="0,0,6,0" />
                <Button Content="S  Lyric continuation" Click="ContinueLyric_Click" />
            </WrapPanel>
            <TextBlock Text="Blank durations divide the maatra equally. For unequal timing, enter fractions such as 1/3 and 2/3."
                       Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Preview" Style="{StaticResource MutedText}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="Preview" HorizontalContentAlignment="Center" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <ListBox x:Name="EventsList" MinHeight="52" MaxHeight="165" AutomationProperties.Name="Swaras in this maatra">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Glyph}" Width="68" HorizontalContentAlignment="Center" />
                            <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                     AutomationProperties.Name="Duration in maatras" Margin="4" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,6,0,6">
                <Button Content="Remove" Click="Remove_Click" Margin="0,0,6,0" />
                <Button Content="Khatka" Click="Khatka_Click" Margin="0,0,6,0" />
                <Button x:Name="KanButton" Content="Kan swar" Click="Kan_Click" Margin="0,0,6,0" />
                <Button Content="Meend to next" Click="Meend_Click" />
            </WrapPanel>
            <CheckBox x:Name="GroupBox" Content="Group swaras under one maatra" Checked="Preview_Changed"
                      Unchecked="Preview_Changed" Margin="0,0,0,10" />
            <Label Content="_Lyrics" Target="{Binding ElementName=LyricsBox}" Padding="0,0,0,4" />
            <TextBox x:Name="LyricsBox" TextChanged="Preview_Changed" FontFamily="Nirmala UI" FontSize="16" Margin="0,0,0,10" />
            <Label Content="_Notes / cues" Target="{Binding ElementName=NotesBox}" Padding="0,0,0,4" />
            <TextBox x:Name="NotesBox" TextWrapping="Wrap" />
            <TextBlock x:Name="Message" Style="{StaticResource MutedText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="_Cancel" IsCancel="True" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                <Button Content="_Apply" IsDefault="True" Click="Apply_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
