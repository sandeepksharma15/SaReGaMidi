<Window x:Class="SaReGaMidi.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SaReGaMidi" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WorkspaceWindow}">
    <Border Style="{StaticResource Card}" Margin="18" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"
                       FontSize="28" Text="&#xE189;" Margin="0,0,0,12" />
            <TextBlock Text="SaReGaMidi" Style="{StaticResource Heading}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
            <TextBlock Style="{StaticResource MutedText}"
                       Text="A Windows workspace for bringing printed Bhatkhande notation into a DAW as separate melody and theka MIDI tracks." />
            <Button x:Name="CloseButton" Content="_Close" Style="{StaticResource ActionButton}" HorizontalAlignment="Right"
                    IsCancel="True" IsDefault="True" Click="Close_Click" Margin="0,18,0,0" />
        </StackPanel>
    </Border>
</Window>
