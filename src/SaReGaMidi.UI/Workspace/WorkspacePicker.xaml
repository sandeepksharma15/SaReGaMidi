<Window x:Class="SaReGaMidi.UI.WorkspacePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open workspace" Width="650" Height="400" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WorkspaceWindow}" Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <TextBlock Text="Saved workspaces" Style="{StaticResource Heading}" DockPanel.Dock="Top" Margin="0,0,0,12" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Content="_Browse folders…" Click="Browse_Click" DockPanel.Dock="Left" Style="{StaticResource ActionButton}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                <Button x:Name="OpenButton" Content="_Open" Click="Open_Click" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <ListBox x:Name="Workspaces" Style="{StaticResource PageListStyle}" AutomationProperties.Name="Saved workspaces"
                     SelectionChanged="Selection_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Message" Text="Looking for saved workspaces…" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14" />
        </Grid>
    </DockPanel>
</Window>
