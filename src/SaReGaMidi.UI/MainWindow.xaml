<Window x:Class="SaReGaMidi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaReGaMidi" Width="1040" Height="740" MinWidth="640" MinHeight="480"
        Loaded="MainWindow_Loaded" WindowStartupLocation="CenterScreen" Style="{StaticResource WorkspaceWindow}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource WorkspaceStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource MutedText}" />
            </StatusBarItem>
        </StatusBar>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Text="&#xE189;" />
                    <TextBlock Text="SaReGaMidi" FontWeight="SemiBold" FontSize="18" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenWorkspaceButton" Style="{StaticResource ActionButton}" Click="OpenWorkspace_Click" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <AccessText Text="_Open workspace" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource IconButton}" Click="About_Click"
                            ToolTip="About SaReGaMidi" AutomationProperties.Name="About SaReGaMidi" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24">
            <Border x:Name="WelcomeCard" Style="{StaticResource Card}" MaxWidth="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34">
                <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"
                               FontSize="30" Text="&#xE8B7;" Margin="0,0,0,14" />
                    <TextBlock Text="Bring in a composition" Style="{StaticResource Heading}" />
                    <TextBlock Text="Add scanned Bhatkhande pages in reading order to start a composition."
                               Style="{StaticResource MutedText}" Margin="0,8,0,20" />
                    <Button x:Name="StartImportButton" Style="{StaticResource PrimaryButton}" Click="ImportComposition_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
                            <AccessText Text="_Import composition" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="275" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButton}" Click="OpenWorkFolder_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" Margin="0,0,8,0" />
                                <AccessText Text="Show in _Explorer" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TranscribeButton" Content="_Transcribe" Style="{StaticResource PrimaryButton}"
                                Click="Transcribe_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ActionButton}" Click="ImportComposition_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                <AccessText Text="_New import" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Review source pages" Style="{StaticResource Heading}" />
                        <TextBlock Text="Select a scan to check the reading order before transcription."
                                   Style="{StaticResource MutedText}" Margin="0,4,12,0" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="12">
                    <DockPanel>
                        <TextBlock x:Name="PageCountText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,0,0,10" />
                        <ListBox x:Name="ReviewPages" Style="{StaticResource PageListStyle}" DisplayMemberPath="Label"
                                 AutomationProperties.Name="Imported pages in reading order"
                                 SelectionChanged="ReviewPages_SelectionChanged" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <Image x:Name="ReviewPreview" Stretch="Uniform"
                           AutomationProperties.Name="Selected composition scan" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
