<Window x:Class="SaReGaMidi.UI.ChordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vibhaag chord" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WorkspaceWindow}">
    <StackPanel Margin="22">
        <TextBlock x:Name="PrincipalText" Margin="0,0,0,12" />
        <Label Content="_Chord" Target="{Binding ElementName=Choices}" />
        <ComboBox x:Name="Choices" SelectionChanged="Choice_Changed" />
        <TextBlock x:Name="ToneText" Margin="0,12,0,4" TextWrapping="Wrap" />
        <TextBlock x:Name="BassText" TextWrapping="Wrap" />
        <Button x:Name="ListenButton" Content="_Listen" Click="Listen_Click" HorizontalAlignment="Left"
                Margin="0,12" Style="{StaticResource ActionButton}" />
        <TextBlock x:Name="Status" Text="Applying a choice saves the current score." Style="{StaticResource MutedText}" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RestoreButton" Content="_Restore automatic" Click="Restore_Click" Style="{StaticResource ActionButton}" />
            <Button Content="Close" IsCancel="True" Margin="8,0" Style="{StaticResource ActionButton}" />
            <Button x:Name="UseButton" Content="_Use this chord" Click="Use_Click" Style="{StaticResource PrimaryButton}" />
        </WrapPanel>
    </StackPanel>
</Window>
