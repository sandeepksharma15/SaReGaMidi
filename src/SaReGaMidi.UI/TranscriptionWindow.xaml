<Window x:Class="SaReGaMidi.UI.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcribe composition" Width="1380" Height="850" MinWidth="840" MinHeight="540"
        Loaded="Window_Loaded" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WorkspaceWindow}">
    <DockPanel Margin="20">
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource WorkspaceStatusBar}" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ReferenceButton" Content="Load Ranjish Hi Sahi draft" Style="{StaticResource ActionButton}"
                        Click="Reference_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="_Save score" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Transcribe composition" Style="{StaticResource Heading}" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="520" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="SourcePages" SelectionChanged="SourcePages_SelectionChanged"
                                  AutomationProperties.Name="Source scan" MinWidth="100" />
                    </DockPanel>
                    <ScrollViewer x:Name="ScanScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ScanImage" Width="{Binding ViewportWidth, ElementName=ScanScroll}"
                               Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Source scan preview" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{DynamicResource LineBrush}"
                          AutomationProperties.Name="Resize source and score panes" />
            <Border x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="14" IsEnabled="False">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <Label Content="_Composition title" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" MinHeight="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="_Taal" Target="{Binding ElementName=TaalBox}" Padding="0,0,0,4" />
                                <ComboBox x:Name="TaalBox" DisplayMemberPath="Name" MinHeight="30"
                                          SelectionChanged="TaalBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   Text="One row per maatra. Enter swaras such as Sa, ReKomal, MaTivra, Ni. (mandra) or Sa' (taar). Separate subdivisions with spaces. Use - for sustain, * for silence, ? for an unclear reading, and S in lyrics for a syllable extension." />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   Text="Subdivisions default to equal lengths. For unequal lengths, use Sa:1/3 Re:2/3. In the first row of each section, set Start beat to the maatra where the section enters." />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="_Add maatra" Style="{StaticResource ActionButton}" Click="Add_Click" Margin="0,0,6,0" />
                            <Button Content="_Insert above" Style="{StaticResource ActionButton}" Click="Insert_Click" Margin="0,0,6,0" />
                            <Button Content="_Remove row" Style="{StaticResource ActionButton}" Click="Remove_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="MaatraGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single"
                              SelectionChanged="MaatraGrid_SelectionChanged" RowEditEnding="MaatraGrid_RowEditEnding"
                              AutomationProperties.Name="Transcription by maatra"
                              EnableRowVirtualization="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Page" Binding="{Binding SourcePage}" Width="48" />
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="80" />
                            <DataGridTextColumn Header="Start beat" Binding="{Binding StartBeat}" Width="80" />
                            <DataGridTextColumn Header="Beat" Binding="{Binding Beat}" IsReadOnly="True" Width="48" />
                            <DataGridTextColumn Header="Swaras" Binding="{Binding Swaras}" Width="130" />
                            <DataGridTextColumn Header="Lyrics" Binding="{Binding Lyrics}" Width="90" />
                            <DataGridTextColumn Header="Notes / cues" Binding="{Binding Annotation}" Width="*" MinWidth="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
