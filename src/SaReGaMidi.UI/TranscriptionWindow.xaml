<Window x:Class="SaReGaMidi.UI.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SaReGaMidi.UI"
        Title="Transcribe composition" Width="1380" Height="850" MinWidth="840" MinHeight="540"
        Loaded="Window_Loaded" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WorkspaceWindow}">
    <Window.Resources>
        <local:SwaraDisplayConverter x:Key="SwaraDisplay" />
    </Window.Resources>
    <DockPanel Margin="20">
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource WorkspaceStatusBar}" Margin="0,12,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="▶  _Play" Click="Play_Click" IsEnabled="False"
                            Style="{StaticResource ActionButton}" MinWidth="76" />
                    <CheckBox x:Name="MelodyBox" Content="Melody" IsChecked="True" Margin="12,0,0,0"
                              Click="Track_Click" VerticalAlignment="Center" />
                    <CheckBox x:Name="ThekaBox" Content="Theka" IsChecked="True" Margin="10,0,12,0"
                              Click="Track_Click" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChordsBox" Content="Chords" IsChecked="True" Margin="0,0,10,0"
                              Click="Track_Click" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="RecognitionProgress" Visibility="Collapsed" IsIndeterminate="True"
                                 Width="72" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Transcription in progress" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="GenerateDraftButton" Content="_Generate draft" Style="{StaticResource ActionButton}"
                        Click="GenerateDraft_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <Button x:Name="ReferenceButton" Content="Load Ranjish Hi Sahi draft" Style="{StaticResource ActionButton}"
                        Click="Reference_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Content="Export _MIDI…" Style="{StaticResource ActionButton}"
                        Click="ExportMidi_Click" IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="_Save score" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Transcribe composition" Style="{StaticResource Heading}" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="520" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="SourcePages" SelectionChanged="SourcePages_SelectionChanged"
                                  AutomationProperties.Name="Source scan" MinWidth="100" />
                    </DockPanel>
                    <ScrollViewer x:Name="ScanScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ScanImage" Width="{Binding ViewportWidth, ElementName=ScanScroll}"
                               Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Source scan preview" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{DynamicResource LineBrush}"
                          AutomationProperties.Name="Resize source and score panes" />
            <Border x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="14" IsEnabled="False">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <Label Content="_Composition title" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" MinHeight="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="_Taal" Target="{Binding ElementName=TaalBox}" Padding="0,0,0,4" />
                                <ComboBox x:Name="TaalBox" DisplayMemberPath="Name" MinHeight="30"
                                          SelectionChanged="TaalBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TabControl x:Name="ScoreTabs" SelectionChanged="ScoreTabs_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,6,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel IsItemsHost="True" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    KeyboardNavigation.TabIndex="0"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        <StackPanel x:Name="RowControls" Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="2">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource IconButton}" Click="Add_Click"
                                                    ToolTip="Add maatra" AutomationProperties.Name="Add maatra">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Click="Insert_Click"
                                                    ToolTip="Insert before selected maatra" AutomationProperties.Name="Insert before selected maatra">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Click="Remove_Click"
                                                    ToolTip="Remove selected maatra" AutomationProperties.Name="Remove selected maatra">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </DockPanel>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="_Notation" Style="{StaticResource WorkspaceTab}" Margin="0,0,6,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="NotationSheet" Grid.IsSharedSizeScope="True" Margin="8" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="_Details" Style="{StaticResource WorkspaceTab}" Margin="0">
                            <DataGrid x:Name="MaatraGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single"
                                      SelectionChanged="MaatraGrid_SelectionChanged" RowEditEnding="MaatraGrid_RowEditEnding"
                                      AutomationProperties.Name="Transcription by maatra"
                                      EnableRowVirtualization="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="84" />
                                    <DataGridTextColumn Header="Beat" Binding="{Binding Beat}" IsReadOnly="True" Width="54" />
                                    <DataGridTemplateColumn Header="Swaras" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding Swaras, Converter={StaticResource SwaraDisplay}}"
                                                                AutomationProperties.Name="{Binding Swaras}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Margin="4,0" Focusable="False" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Swaras, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="New line" Binding="{Binding StartsPrintedLine}" Width="76" />
                                    <DataGridTextColumn Header="Lyrics" Binding="{Binding Lyrics}" Width="90" />
                                    <DataGridTextColumn Header="Notes / cues" Binding="{Binding Annotation}" Width="*" MinWidth="135" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="_Analysis" Style="{StaticResource WorkspaceTab}" Margin="6,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <WrapPanel VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,24,12">
                                            <Label Content="Base note (Sa)" Target="{Binding ElementName=AnalysisSa}" Padding="0,0,0,4" />
                                            <ComboBox x:Name="AnalysisSa" MinWidth="100" SelectionChanged="AnalysisSa_Changed" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <Label Content="{Binding ElementName=RareCutoff, Path=Value}"
                                                   Target="{Binding ElementName=RareCutoff}" Padding="0,0,0,4" ContentStringFormat="Rare below {0:0}%" />
                                            <Slider x:Name="RareCutoff" Minimum="0" Maximum="100" Value="5" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" Width="176" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Rare note cutoff in percent" ValueChanged="RareCutoff_Changed" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="AnalysisSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <StackPanel x:Name="AnalysisResults" Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
