<Window x:Class="SaReGaMidi.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings • SaReGaMidi" Width="635" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WorkspaceWindow}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource WorkspaceStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource MutedText}" />
            </StatusBarItem>
        </StatusBar>
        <StackPanel Margin="24">
            <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Label Content="_Work folder" Target="{Binding ElementName=WorkFolderBox}" FontWeight="SemiBold" Padding="0" />
                    <TextBlock Text="Each new import gets its own folder for scans and artifacts."
                               Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                    <DockPanel>
                        <Button Style="{StaticResource ActionButton}" Click="Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                                <AccessText Text="_Browse…" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="WorkFolderBox" MinHeight="36" Padding="8,4" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Label Content="_Theme" Target="{Binding ElementName=ThemeBox}" FontWeight="SemiBold" Padding="0" />
                    <ComboBox x:Name="ThemeBox" Width="176" MinHeight="36" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Label Content="At _startup" Target="{Binding ElementName=StartupBox}" FontWeight="SemiBold" Padding="0" />
                    <ComboBox x:Name="StartupBox" Width="245" MinHeight="36" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <ComboBoxItem Content="Reopen previous workspace" />
                        <ComboBoxItem Content="Start with a blank workspace" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="_Cancel" Style="{StaticResource ActionButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                        <AccessText Text="_Save settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
